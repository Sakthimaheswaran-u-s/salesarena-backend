PORT=8080
MONGO_URI=mongodb://localhost:27017
MONGO_DB=salesarena
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Bearer-token session lifetime (sliding)
SESSION_TTL=24h
# IANA zone used for "today" / streak boundaries, e.g. Asia/Kolkata
TZ=Local
# Seed the 60-day demo dataset when the users collection is empty
SEED_ON_START=true
# Expose POST /api/demo/reset (disable in production!)
DEMO_MODE=true
# debug | release
GIN_MODE=debug
